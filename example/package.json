{
  "name": "react-native-nitro-pretext-example",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "pods": "pod install --project-directory=ios",
    "ios:signing": "bundle exec fastlane ios sync_signing readonly:true",
    "ios:signing:write": "bundle exec fastlane ios sync_signing readonly:false type:development",
    "ios:match": "bundle exec fastlane match development --readonly",
    "ios:match:write": "bundle exec fastlane match development",
    "ios": "yarn pods && react-native run-ios --simulator \"${IOS_SIMULATOR:-iPhone 16}\" --no-packager",
    "ios:device": "yarn pods && react-native run-ios --no-packager",
    "start": "react-native start",
    "build:android": "react-native build-android --extra-params \"--no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a\"",
    "build:ios": "react-native build-ios --mode Debug"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.85.0",
    "react-native-nitro-modules": "^0.35.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.85.0",
    "@react-native/jest-preset": "0.85.0",
    "@react-native/metro-config": "0.85.0",
    "@react-native/typescript-config": "0.85.0",
    "@types/react": "^19.2.0",
    "react-native-builder-bob": "^0.41.0",
    "react-native-monorepo-config": "^0.3.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
