{
  "name": "react-native-nitro-pretext",
  "version": "0.0.1",
  "description": "Layout-only Pretext engine for React Native text geometry before render",
  "keywords": [
    "android",
    "ios",
    "react-native"
  ],
  "homepage": "https://github.com/jingjing2222/react-native-nitro-pretext#readme",
  "bugs": {
    "url": "https://github.com/jingjing2222/react-native-nitro-pretext/issues"
  },
  "license": "MIT",
  "author": "jingjing2222 <hj.jingjing2222@gmail.com> (https://github.com/jingjing2222)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jingjing2222/react-native-nitro-pretext.git"
  },
  "workspaces": [
    ".",
    "example"
  ],
  "files": [
    "src",
    "dist",
    "docs",
    "CONTRIBUTING.md",
    "android",
    "ios",
    "cpp",
    "nitrogen",
    "nitro.json",
    "*.podspec",
    "react-native.config.js",
    "!oxfmt.config.ts",
    "!oxlint.config.ts",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "main": "./dist/module/index.js",
  "types": "./dist/types/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "default": "./dist/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "example:ios": "yarn workspace react-native-nitro-pretext-example ios",
    "example:android": "yarn workspace react-native-nitro-pretext-example android",
    "examples:ios": "yarn workspace react-native-nitro-pretext-example examples:ios",
    "examples:android": "yarn workspace react-native-nitro-pretext-example examples:android",
    "benchmark:ios": "yarn workspace react-native-nitro-pretext-example benchmark:ios",
    "benchmark:android": "yarn workspace react-native-nitro-pretext-example benchmark:android",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib dist",
    "build": "del-cli lib dist && bob build && node scripts/patch-module-imports.js && tsc -p tsconfig.build.json",
    "prepack": "yarn build",
    "nitrogen": "nitrogen",
    "changeset": "changeset",
    "release": "changeset publish",
    "typecheck": "tsc",
    "test": "jest",
    "verify:api-examples": "node scripts/verify-api-example-map.js",
    "verify:package-exports": "node scripts/verify-package-exports.js",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@jest/globals": "^30.0.0",
    "@react-native/babel-preset": "0.85.0",
    "@react-native/jest-preset": "0.85.0",
    "@types/react": "^19.2.0",
    "del-cli": "^7.0.0",
    "jest": "^30.3.0",
    "nitrogen": "^0.35.5",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "react": "19.2.3",
    "react-native": "0.85.0",
    "react-native-builder-bob": "^0.41.0",
    "react-native-nitro-modules": "^0.35.5",
    "turbo": "^2.8.21",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.81.0",
    "react-native-nitro-modules": "^0.35.5"
  },
  "jest": {
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/dist/",
      "<rootDir>/lib/"
    ],
    "preset": "@react-native/jest-preset",
    "watchman": false
  },
  "packageManager": "yarn@4.11.0",
  "create-react-native-library": {
    "type": "nitro-module",
    "languages": "kotlin-swift",
    "tools": [
      "jest"
    ],
    "version": "0.61.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "dist",
    "targets": [
      [
        "custom",
        {
          "script": "nitrogen",
          "clean": "nitrogen/"
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ]
    ]
  }
}
