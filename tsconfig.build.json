{
  "extends": "./tsconfig",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist/types",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/__tests__/**", "example", "dist", "lib"]
}
